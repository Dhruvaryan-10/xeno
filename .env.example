# Copy to .env at the repo root. All three apps read it.

# --- AI (optional) ---------------------------------------------------------
# Without a key the API uses deterministic fallbacks, so the demo still works.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Secrets (required when NODE_ENV=production) ---------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Shared by the web proxy and the CRM API.
CRM_API_KEY=""
# Shared by the CRM API and the channel service (bearer auth + webhook HMAC).
CHANNEL_SHARED_SECRET=""

# --- Service URLs ----------------------------------------------------------
CRM_PORT=4000
CHANNEL_PORT=4100
# Server-side only: where the Next.js proxy forwards /api/* requests.
CRM_API_URL="http://localhost:4000"
# Public URL the channel service calls back on.
CRM_PUBLIC_URL="http://localhost:4000"
CHANNEL_SERVICE_URL="http://localhost:4100"
# Origins the channel service may call back to (comma-separated). Defaults to CRM_PUBLIC_URL.
ALLOWED_CALLBACK_ORIGINS="http://localhost:4000"
# Browser origins allowed to call the CRM API directly (comma-separated).
CORS_ORIGINS="http://localhost:3000"

# --- Storage ---------------------------------------------------------------
# JSON store path. Use a persistent disk in production.
DATA_FILE="data/store.json"
