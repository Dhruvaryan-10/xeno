# Copy to .env at the repo root for local development. Everything is optional.

# Gemini writes the copy, picks channels and reads audiences. Without a key the app
# uses built-in rule-based answers, so it still works end to end.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Upstash Redis keeps campaigns. On Vercel these are added automatically when you
# connect Upstash from the Storage tab. Locally, leave them empty to keep campaigns
# in memory (they reset when the dev server restarts).
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
